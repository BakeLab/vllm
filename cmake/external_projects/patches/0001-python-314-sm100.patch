diff --git a/cmake/utils.cmake b/cmake/utils.cmake
index ed41ab4..d8815eb 100644
--- a/cmake/utils.cmake
+++ b/cmake/utils.cmake
@@ -6 +6 @@
-# Attempt to find the python package and verifies that it is one of the `SUPPORTED_VERSIONS`.
+# Attempt to find the Python package and verifies that it meets the minimum version.
@@ -8 +8 @@
-macro (find_python_constrained_versions SUPPORTED_VERSIONS)
+macro (find_python_constrained_versions MINIMUM_VERSION)
@@ -18,2 +18 @@ macro (find_python_constrained_versions SUPPORTED_VERSIONS)
-  set(_SUPPORTED_VERSIONS_LIST ${SUPPORTED_VERSIONS} ${ARGN})
-  if (NOT _VER IN_LIST _SUPPORTED_VERSIONS_LIST)
+  if (Python_VERSION VERSION_LESS "${MINIMUM_VERSION}")
@@ -21,2 +20,2 @@ macro (find_python_constrained_versions SUPPORTED_VERSIONS)
